# Copie para .env (ou exporte as variáveis) — nunca versione valores reais.
PORT=3000
# ":memory:" (padrão) recria o banco e o seed a cada boot; um caminho de arquivo persiste os dados.
DB_FILENAME=:memory:
# Token exigido no cabeçalho X-Admin-Token das rotas administrativas. Vazio = rotas bloqueadas.
ADMIN_TOKEN=
PAYMENT_GATEWAY_KEY=
# debug | info | warn | error
LOG_LEVEL=info
