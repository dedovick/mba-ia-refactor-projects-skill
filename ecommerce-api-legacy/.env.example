# Porta HTTP (padrão: 3000)
PORT=3000
# Caminho do banco SQLite (padrão: :memory:, recriado e semeado a cada boot)
DB_PATH=:memory:
# Chave do gateway de pagamento
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token pelas rotas administrativas (vazio = rotas bloqueadas)
ADMIN_TOKEN=
# debug | info | warn | error
LOG_LEVEL=info
