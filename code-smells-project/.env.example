# Copie para .env (ou exporte no shell) e preencha. Nunca versione valores reais.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Caminho do SQLite; vazio = loja.db na raiz do projeto
DATABASE_PATH=
# Origens permitidas para CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# Token exigido no header X-Admin-Token pelas rotas /admin/*; vazio = rotas admin desabilitadas
ADMIN_TOKEN=
# Senha do usuário admin criado pelo seed; vazio = senha aleatória
SEED_ADMIN_PASSWORD=
APP_ENV=producao
LOG_LEVEL=INFO
