# Copie para .env (ou exporte no ambiente) e preencha. Nunca versione valores reais.
SECRET_KEY=
# Token exigido no header X-Admin-Token pelas rotas /admin/*. Vazio = rotas admin desativadas (401).
ADMIN_TOKEN=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Caminho do banco SQLite. Vazio = loja.db na raiz do projeto.
DATABASE_PATH=
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
APP_ENV=producao
LOG_LEVEL=INFO
